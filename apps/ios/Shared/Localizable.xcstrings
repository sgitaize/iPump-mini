    },
    "Ganze Anleitung" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full guide"
          }
        }
      }
    },
    "gekoppelt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "paired"
          }
        }
      }
    },
    "Gekoppelt. Die Pumpe verbindet sich von selbst, sobald sie in Reichweite ist. Die App muss dafür geöffnet bleiben (im Hintergrund ist ok, nicht wegwischen)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paired. The pump connects by itself as soon as it is in range. The app has to stay open for this (background is fine, don't swipe it away)."
          }
        }
      }
    },
    "gerade eben" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "just now"
          }
        }
      }
    },
    "Gespeichert. Die App kann jetzt mit der Pumpe sprechen." : {
      "extractionState" : "manual",
      "localizations" : {
