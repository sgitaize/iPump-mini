            "value" : "Time-sensitive notifications"
          }
        }
      }
    },
    "Zeitkritische Mitteilungen folgen dem Stummschalter. Nachts das iPhone nicht stumm schalten, Lautstärke für Klingelton und Hinweise ausreichend hoch einstellen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time-sensitive notifications follow the silent switch. Don't silence the iPhone at night, and set the ringer and alert volume high enough."
          }
        }
      }
    },
    "Zeitraum" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
