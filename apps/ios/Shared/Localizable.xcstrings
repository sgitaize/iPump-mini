            "value" : "Early calibration"
          }
        }
      }
    },
    "Füge iPump-mini in deinem Schlaf-Fokus unter „Erlaubte Apps“ hinzu, sonst bleiben Alarme nachts stumm." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add iPump-mini to your Sleep Focus under “Allowed apps”, otherwise alarms stay silent at night."
          }
