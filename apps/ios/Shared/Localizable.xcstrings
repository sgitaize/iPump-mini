      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target range and unit apply to the display, graph and widgets. Alarm thresholds are set under Alarms. Nightscout and the local API stay in mg/dL."
          }
        }
      }
    },
